{
  "pi_bin": "pi",
  "model": "",
  "thinking": "medium",
  "tools": "",
  "timeout_seconds": 1500,
  "timeout_grace_seconds": 300,
  "max_turns": 0,
  "log_tail_lines": 40,
  "ephemeral_sessions": false,
  "offline": false,
  "project_trust": "approve",
  "prompt_mode": "stdin",
  "stream_output": true,
  "stream_thinking": true,
  "stream_raw": false,
  "color": "auto",
  "max_attempts": 3,
  "verify_commands": [
    "npm run lint",
    "npx tsc --noEmit"
  ],
  "verify_timeout_seconds": 900,
  "verify_env_script": "",
  "require_tests": false,
  "source_globs": [
    "src/**"
  ],
  "test_globs": [
    "tests/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "commit": false,
  "push": false
}
