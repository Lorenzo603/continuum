# =============================================================================
# Continuum â€” Database Configuration
# =============================================================================

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/continuum_example

# Auth mode switch (build-time):
# - true  => Clerk auth enabled
# - false => legacy ACCESS_TOKEN header auth
NEXT_PUBLIC_ENABLE_CLERK_AUTH=true

# Legacy token auth settings (used when NEXT_PUBLIC_ENABLE_CLERK_AUTH=false)
ACCESS_TOKEN=<TOKEN_PLACEHOLDER>
ACCESS_TOKEN_CHECK_DISABLED=false
LEGACY_AUTH_USER_ID=legacy-user

# Clerk Authentication DEV
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# # Clerk Authentication PROD
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# CLERK_SECRET_KEY=sk_live_replace_me

# MCP machine auth (choose one option)
# Option A: pre-minted Clerk bearer token
# CLERK_MCP_BEARER_TOKEN=
#
# Option B: client credentials flow
# CLERK_M2M_TOKEN_URL=
# CLERK_M2M_CLIENT_ID=
# CLERK_M2M_CLIENT_SECRET=
# CLERK_M2M_AUDIENCE=
# CLERK_M2M_SCOPE=

# MCP Configs
CONTINUUM_API_BASE_URL=http://localhost:7000

# Playwright UI smoke tests — dedicated Clerk test user (never commit real values)
PLAYWRIGHT_CLERK_EMAIL=
PLAYWRIGHT_CLERK_PASSWORD=
